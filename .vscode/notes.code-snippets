{
  // LaTeX snippets for notes/*.md. Type the prefix, press Tab.
  // Notation follows Bishop & Bishop (bold lowercase vectors, bold uppercase matrices).
  "Display math":   { "scope": "markdown", "prefix": "dm",     "body": ["", "\\$\\$", "$1", "\\$\\$", "", "$0"] },
  "Inline math":    { "scope": "markdown", "prefix": "im",     "body": "\\$$1\\$$0" },
  "Aligned block":  { "scope": "markdown", "prefix": "al",     "body": ["", "\\$\\$", "\\begin{aligned}", "$1 &= $2 \\\\\\\\", "  &= $3", "\\end{aligned}", "\\$\\$", "", "$0"] },
  "Bold":           { "scope": "markdown", "prefix": "bf",     "body": "\\mathbf{$1}$0" },
  "Bold symbol":    { "scope": "markdown", "prefix": "bs",     "body": "\\boldsymbol{$1}$0" },
  "bold x":         { "scope": "markdown", "prefix": "bx",     "body": "\\mathbf{x}" },
  "bold w":         { "scope": "markdown", "prefix": "bw",     "body": "\\mathbf{w}" },
  "bold t":         { "scope": "markdown", "prefix": "bt",     "body": "\\mathbf{t}" },
  "bold y":         { "scope": "markdown", "prefix": "by",     "body": "\\mathbf{y}" },
  "bold X":         { "scope": "markdown", "prefix": "bX",     "body": "\\mathbf{X}" },
  "bold phi":       { "scope": "markdown", "prefix": "bphi",   "body": "\\boldsymbol{\\phi}" },
  "bold Phi":       { "scope": "markdown", "prefix": "bPhi",   "body": "\\boldsymbol{\\Phi}" },
  "bold mu":        { "scope": "markdown", "prefix": "bmu",    "body": "\\boldsymbol{\\mu}" },
  "bold Sigma":     { "scope": "markdown", "prefix": "bSig",   "body": "\\boldsymbol{\\Sigma}" },
  "Reals":          { "scope": "markdown", "prefix": "RR",     "body": "\\mathbb{R}^{$1}$0" },
  "Expectation":    { "scope": "markdown", "prefix": "EE",     "body": "\\mathbb{E}\\left[$1\\right]$0" },
  "Variance":       { "scope": "markdown", "prefix": "Var",    "body": "\\operatorname{var}\\left[$1\\right]$0" },
  "Gaussian":       { "scope": "markdown", "prefix": "NN",     "body": "\\mathcal{N}(${1:x} \\mid ${2:\\mu}, ${3:\\sigma^2})$0" },
  "Conditional p":  { "scope": "markdown", "prefix": "pp",     "body": "p(${1:t} \\mid ${2:\\mathbf{x\\}, \\mathbf{w\\}})$0" },
  "Gradient":       { "scope": "markdown", "prefix": "grad",   "body": "\\nabla_{${1:\\mathbf{w\\}}} $0" },
  "Partial":        { "scope": "markdown", "prefix": "pd",     "body": "\\frac{\\partial ${1:E}}{\\partial ${2:w}}$0" },
  "Fraction":       { "scope": "markdown", "prefix": "fr",     "body": "\\frac{$1}{$2}$0" },
  "Sum n=1..N":     { "scope": "markdown", "prefix": "sumn",   "body": "\\sum_{${1:n}=1}^{${2:N}} $0" },
  "Prod n=1..N":    { "scope": "markdown", "prefix": "prodn",  "body": "\\prod_{${1:n}=1}^{${2:N}} $0" },
  "Transpose":      { "scope": "markdown", "prefix": "TT",     "body": "^{\\mathrm{T}}" },
  "Inverse":        { "scope": "markdown", "prefix": "inv",    "body": "^{-1}" },
  "Squared norm":   { "scope": "markdown", "prefix": "norm",   "body": "\\lVert $1 \\rVert^2$0" },
  "argmin":         { "scope": "markdown", "prefix": "argmin", "body": "\\operatorname*{arg\\,min}_{${1:\\mathbf{w\\}}} $0" },
  "argmax":         { "scope": "markdown", "prefix": "argmax", "body": "\\operatorname*{arg\\,max}_{${1:\\mathbf{w\\}}} $0" },
  "Trace":          { "scope": "markdown", "prefix": "Tr",     "body": "\\operatorname{Tr}\\left($1\\right)$0" }
}
